http://localhost/LeonsTienda/inicio-sesion.php

<?php
include("conexion.php");

$mensaje = "";
$tipo_mensaje = "";
$redirigir = false;

if ($_SERVER["REQUEST_METHOD"] === "POST") {
    $nombre = trim($_POST["nombre"]);
    $apellido = trim($_POST["apellido"]);
    $correo = trim($_POST["correo"]);
    $contrasena = $_POST["contrasena"];
    $celular = trim($_POST["celular"]);
    $direccion = trim($_POST["direccion"]);
    $acepta_terminos = isset($_POST["terminos"]);

    if (!$acepta_terminos) {
        $mensaje = "Debes aceptar los términos y condiciones.";
        $tipo_mensaje = "error";

    } elseif (!preg_match('/^[0-9]{10}$/', $celular)) {
        $mensaje = "El celular debe tener exactamente 10 números.";
        $tipo_mensaje = "error";

    } else {
        $verificar = $conexion->prepare(
            "SELECT id_cliente FROM clientes WHERE correo = ?"
        );

        $verificar->bind_param("s", $correo);
        $verificar->execute();
        $resultado = $verificar->get_result();

        if ($resultado->num_rows > 0) {
            $mensaje = "Este correo ya se encuentra registrado.";
            $tipo_mensaje = "error";

        } else {
            $contrasena_segura = password_hash($contrasena, PASSWORD_DEFAULT);

            $insertar = $conexion->prepare(
                "INSERT INTO clientes (nombre, apellido, correo, contraseña, celular, direccion)
                 VALUES (?, ?, ?, ?, ?, ?)"
            );

            $insertar->bind_param(
                "ssssss",
                $nombre,
                $apellido,
                $correo,
                $contrasena_segura,
                $celular,
                $direccion
            );

            if ($insertar->execute()) {
                $mensaje = "¡Registro exitoso! Bienvenido(a), " . $nombre . ". Serás redirigido a la página principal.";
                $tipo_mensaje = "exito";
                $redirigir = true;
            } else {
                $mensaje = "No fue posible completar el registro.";
                $tipo_mensaje = "error";
            }
        }
    }
}
