   <script>
      function consultarEnvio() {
         let pedido = document.getElementById("pedido").value;
         let correo = document.getElementById("correo").value;
         let resultado = document.getElementById("resultado");

         if (pedido === "" || correo === "") {
            resultado.innerHTML = `
               <p class="resultado-envio">
                  Por favor, completa todos los campos.
               </p>
            `;
            return;
         }

         resultado.innerHTML = `
            <div class="resultado-envio">
               <strong>Pedido encontrado</strong>
               <p>Número de pedido: ${pedido}</p>
               <p>Estado actual: En preparación</p>
               <p>Tu pedido está siendo preparado para el envío.</p>
            </div>
         `;
      }
   </script>

